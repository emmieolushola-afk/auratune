# Copy to .env.local and fill in as needed. The app runs in demo mode with
# none of these set.

# Signs session cookies for demo-mode auth (scrypt is already handled in-code).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Optional: Supabase (hosted Postgres + auth) ---
# When set, the app can be migrated off the file-backed demo store.
# See supabase/schema.sql and src/lib/supabase/*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=